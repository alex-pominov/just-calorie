######################
# Project Specific
######################
.expo/
# Leading slash so we only exclude the Expo-generated native project at the
# repo root, not any `ios/` folder nested inside a local native module such
# as `modules/lazy-share/ios/`.
/ios/
/android/
*.jks
*.p8
*.key
*.orig.*
.tmp
*.ipa
*.apk
.env*.local
.env
.turbo
tsconfig.tsbuildinfo
dist*

# Git worktrees (project-local isolated workspaces)
.worktrees/

# Claude/LLM generated files
.claude/
plan.md
final_plan.md
plan_completion_report.md
changes.md
result.md
implementation.md
.serena/

# Expo generated files
expo-env.d.ts
credentials.json
credentials/
*.p12
*.mobileprovision

######################
# Mac OSX
######################
.DS_Store

# Thumbnails
._*

# Files that might appear on external disk
.Spotlight-V100
.Trashes

######################
# Node
######################
npm-debug.*
# No trailing slash: `node_modules/` matches directories only, so a
# node_modules SYMLINK (what you get when a git worktree borrows the main
# checkout's install) slips past it and lands in `git add -A`.
node_modules

